! Namelist file for PDAF configuration

&pdaf_nml
  screen = 2
  dim_ens = 2
  filtertype = 7
  subtype = 0
  type_trans = 0
  type_sqrt = 0
  type_forget = 0
  forget = 0.8
  locweight = 2
/

&io_nml
  verbose_io = 2
  sgldbl_io = 'dbl'
  path_dom = '/work/n01/n01/ymchen/ersem/ersem-pdaf/run/exp_test/ens_1'
  fname_dom = 'domain_cfg.nc'
  ! the parth to restart files is constructed by the following variables
  ! path_rst_root//ens_prefix[1-N]//path_rst_suffix//f_basename_rst_000x.nc
  path_rst_root = '/work/n01/n01/ymchen/ersem/ersem-pdaf/run/exp_test/'
  ! ensemble prefix
  ! ensemble numbers must be from 1 - N, it cannot have zero paddings.
  ens_prefix = 'ens_'
  ! rest of the path to restart files
  path_rst_suffix = 'restarts'
  f_basename_rst = 'amm7_ersem_pdaf_19930102_restart'
  ! the parth to increment files is constructed by the following variables
  ! path_incr_root/ens_prefix[1-N]/assim_background_increments_xxxx.nc
  path_incr_root = '/work/n01/n01/ymchen/ersem/ersem-pdaf/run/exp_test/'
  ! initial time of day in hhmm
  nn_time0 = 0
/

&sv_nml
  n_fields=2
  use_wet_state = 2
/

&sfields_nml
  sfields(1)%ndims = 3
  sfields(1)%variable = 'thetao'
  sfields(1)%name_incr = 'bckint'
  sfields(1)%name_rest_n = 'tn'
  sfields(1)%name_rest_b = 'tb'
  sfields(1)%rst_file = 'amm7_ersem_pdaf_19930102_restart'
  sfields(1)%unit = 'degC'

  sfields(2)%ndims = 3
  sfields(2)%variable = 'so'
  sfields(2)%name_incr = 'bckins'
  sfields(2)%name_rest_n = 'sn'
  sfields(2)%name_rest_b = 'sb'
  sfields(2)%rst_file = 'amm7_ersem_pdaf_19930102_restart'
  sfields(2)%unit = 'psu'
  sfields(2)%transform = 0
  sfields(2)%trafo_shift = 0.0
  sfields(2)%limit = 0
  sfields(2)%min_limit = 0.000001
/

&mgrid_ssh_nml
  assim_ssh_mgrid = .true.
  use_global_obs = 1
  id_sfields = 1
  rms = 0.5
  lradius = 20000
  sradius = 20000
  noise_amp = 0.5
/
