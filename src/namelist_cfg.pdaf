! Namelist file for PDAF configuration

&pdaf_nml
  screen = 2
  dim_ens = 5
  filtertype = 7
  subtype = 0
  type_trans = 0
  type_sqrt = 0
  type_forget = 0
  forget = 0.8
  locweight = 2
/

&io_nml
  verbose_io = 3
  sgldbl_io = 'dbl'
  path_dom = '/work/n01/n01/elicoo/CRISP_NEMO_PDAF/CRISP_NEMO_PDAF_1/nemo_5.0.1/cfgs/exp-build-notop/EXP00_template_rundir/'
  fname_dom = 'ORCA_R2_zps_domcfg.nc'
  ! the parth to restart files is constructed by the following variables
  ! path_rst_root//ens_prefix[1-N]//path_rst_suffix//f_basename_rst_000x.nc
  path_rst_root = '/work/n01/n01/elicoo/CRISP_NEMO_PDAF/CRISP_NEMO_PDAF_1/nemo_5.0.1/cfgs/exp-build-notop/'
  ! ensemble prefix
  ! ensemble numbers must be from 1 - N, it cannot have zero paddings.
  ens_prefix = 'ens_'
  ! rest of the path to restart files
  path_rst_suffix = 'restart_end_ctrl/'
  f_basename_rst = 'ORCA2_00043800_restart_end_ctrl'
  ! the parth to increment files is constructed by the following variables
  ! path_asm_root//ens_prefix[1-N]/assim_background_increments_xxxx.nc
  ! path_asm_root//ens_prefix[1-N]/assim_background_state_DI_xxxx.nc
  path_asm_root = '/work/n01/n01/elicoo/CRISP_NEMO_PDAF/CRISP_NEMO_PDAF_1/nemo_5.0.1/cfgs/exp-build-notop/'
  ! initial time of day in hhmm
  nn_time0 = 0
/

&sv_nml
  n_fields=2
  use_wet_state = 2
/

&sfields_nml
  sfields(1)%ndims = 3
  sfields(1)%variable = 'thetao'
  sfields(1)%name_incr = 'bckint'
  sfields(1)%name_rest_n = 'tn'
  sfields(1)%name_rest_b = 'tb'
  sfields(1)%rst_file = 'ORCA2_00043800_restart_end_ctrl'
  sfields(1)%unit = 'degC'

  sfields(2)%ndims = 3
  sfields(2)%variable = 'so'
  sfields(2)%name_incr = 'bckins'
  sfields(2)%name_rest_n = 'sn'
  sfields(2)%name_rest_b = 'sb'
  sfields(2)%rst_file = 'ORCA2_00043800_restart_end_ctrl'
  sfields(2)%unit = 'psu'
  sfields(2)%transform = 0
  sfields(2)%trafo_shift = 0.0
  sfields(2)%limit = 0
  sfields(2)%min_limit = 0.000001
/

&mgrid_ssh_nml
  assim_ssh_mgrid = .true.
  varname_ssh_mgrid = 'zos'
  file_ssh_mgrid = '../../nemo_5.0.1/cfgs/exp-build-notop/EXP6_ens6_incprecip/ORCA2_5d_20100101_20141231_grid_T.nc'
  use_global_obs = 1
  ! this is the index of obs. in sfields for fake obs.
  id_sfields = 1
  rms = 0.5
  lradius = 20000
  sradius = 20000
  !noise_amp = 0.5
/
